# Core image build configuration (Dokploy builds from docker-compose.yml)
FRAPPE_PATH=https://github.com/frappe/frappe
FRAPPE_BRANCH=version-16

# Optional cache busting for app/image refresh (set to a changing value when needed)
CACHE_BUST=

# Built image reference (used by all services in this stack)
CUSTOM_IMAGE=local/frappe-custom
CUSTOM_TAG=v16
PULL_POLICY=never
RESTART_POLICY=unless-stopped

# Runtime versions
ERPNEXT_VERSION=v16.34.1

# Required site/bootstrap settings
SITE_NAME=erp.example.com
DB_ROOT_USER=root
DB_PASSWORD=change-me-strong-db-password
ADMIN_PASSWORD=change-me-strong-admin-password

# Frontend/site routing
FRAPPE_SITE_NAME_HEADER=erp.example.com
HTTP_PUBLISH_PORT=8080

# Optional frontend tuning
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

# Optional backend tuning
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Migration control
MIGRATE_SITES=true
